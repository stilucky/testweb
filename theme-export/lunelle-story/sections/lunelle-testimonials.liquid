
{% comment %} Lunelle Story — Testimonials {% endcomment %}
<section class="ls-reviews page-width section">
  <div class="ls-reviews__header">
    <span class="ls-reviews__label">Client Stories</span>
    <h2 class="ls-reviews__title">What Our Clients Say</h2>
  </div>
  <div class="ls-reviews__grid">
    <div class="ls-reviews__card">
      <div class="ls-reviews__stars">★★★★★</div>
      <p class="ls-reviews__quote">"I wore the Celestine Lace Dress to my sister's pre-wedding and received endless compliments. The quality and elegance are unmatched."</p>
      <div class="ls-reviews__author">
        <span class="ls-reviews__name">Sophia M.</span>
        <span class="ls-reviews__city">New York</span>
      </div>
    </div>
    <div class="ls-reviews__card">
      <div class="ls-reviews__stars">★★★★★</div>
      <p class="ls-reviews__quote">"Lunelle Story has become my go-to for special occasion dressing. Each piece feels like it was made for me personally."</p>
      <div class="ls-reviews__author">
        <span class="ls-reviews__name">Linh N.</span>
        <span class="ls-reviews__city">Los Angeles</span>
      </div>
    </div>
    <div class="ls-reviews__card">
      <div class="ls-reviews__stars">★★★★★</div>
      <p class="ls-reviews__quote">"The Margot Slip Dress is everything. Incredibly versatile — I've worn it dressed up and down. Absolute perfection."</p>
      <div class="ls-reviews__author">
        <span class="ls-reviews__name">Charlotte R.</span>
        <span class="ls-reviews__city">Toronto</span>
      </div>
    </div>
  </div>
</section>

<style>
.ls-reviews { padding-block: 80px; background: #fafaf9; }
.ls-reviews__header { text-align: center; margin-bottom: 56px; }
.ls-reviews__label {
  display: block;
  font-family: 'Inter', sans-serif;
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.28em;
  text-transform: uppercase;
  color: #a8a29e;
  margin-bottom: 12px;
}
.ls-reviews__title {
  font-family: 'Cormorant Garamond', Georgia, serif !important;
  font-size: clamp(28px, 3.5vw, 48px) !important;
  font-weight: 300 !important;
  letter-spacing: 0.06em !important;
  color: #1c1917 !important;
  margin: 0 !important;
}
.ls-reviews__grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 32px;
}
@media (max-width: 749px) {
  .ls-reviews__grid { grid-template-columns: 1fr; gap: 24px; }
}
.ls-reviews__card {
  padding: 40px 32px;
  background: #ffffff;
  border: 1px solid #e7e5e4;
  display: flex;
  flex-direction: column;
  gap: 20px;
}
.ls-reviews__stars {
  color: #1c1917;
  font-size: 14px;
  letter-spacing: 0.1em;
}
.ls-reviews__quote {
  font-family: 'Cormorant Garamond', Georgia, serif;
  font-size: 18px;
  font-style: italic;
  font-weight: 300;
  line-height: 1.6;
  color: #44403c;
  margin: 0;
  flex: 1;
}
.ls-reviews__author { display: flex; flex-direction: column; gap: 2px; }
.ls-reviews__name {
  font-family: 'Inter', sans-serif;
  font-size: 13px;
  font-weight: 600;
  letter-spacing: 0.06em;
  color: #1c1917;
}
.ls-reviews__city {
  font-family: 'Inter', sans-serif;
  font-size: 11px;
  color: #a8a29e;
  letter-spacing: 0.1em;
}
</style>

{% schema %}
{ "name": "Lunelle Testimonials", "tag": "section", "settings": [] }
{% endschema %}
