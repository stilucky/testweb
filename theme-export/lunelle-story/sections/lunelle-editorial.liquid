
{% comment %} Lunelle Story — Editorial Banner {% endcomment %}
<section class="ls-editorial">
  <div class="ls-editorial__img-wrap">
    <img src="https://images.unsplash.com/photo-1490481651871-ab68de25d43d?w=1600&q=80" alt="Resort 2025" loading="lazy">
    <div class="ls-editorial__overlay"></div>
  </div>
  <div class="ls-editorial__content">
    <span class="ls-editorial__label">L'ÉCHO · Resort 2025</span>
    <h2 class="ls-editorial__title">Where Luxury<br><em>Meets The Sea</em></h2>
    <p class="ls-editorial__desc">Our resort collection draws inspiration from sun-drenched coastlines and languid afternoons. Each piece crafted for the woman who moves through the world with effortless grace.</p>
    <div class="ls-editorial__btns">
      <a href="/collections/resort" class="ls-editorial__btn ls-editorial__btn--primary">Explore Resort</a>
      <a href="/pages/about" class="ls-editorial__btn ls-editorial__btn--secondary">Our Story</a>
    </div>
  </div>
</section>

<style>
.ls-editorial {
  display: grid;
  grid-template-columns: 1fr 1fr;
  min-height: 600px;
}
@media (max-width: 749px) {
  .ls-editorial { grid-template-columns: 1fr; }
}
.ls-editorial__img-wrap {
  position: relative;
  overflow: hidden;
  min-height: 480px;
}
.ls-editorial__img-wrap img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.9s cubic-bezier(0.25,0.46,0.45,0.94);
}
.ls-editorial:hover .ls-editorial__img-wrap img { transform: scale(1.03); }
.ls-editorial__overlay {
  position: absolute;
  inset: 0;
  background: rgba(28,25,23,0.12);
}
.ls-editorial__content {
  background: #f5f5f4;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: clamp(40px, 7vw, 100px);
  gap: 24px;
}
.ls-editorial__label {
  font-family: 'Inter', sans-serif;
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.3em;
  text-transform: uppercase;
  color: #a8a29e;
}
.ls-editorial__title {
  font-family: 'Cormorant Garamond', Georgia, serif !important;
  font-size: clamp(36px, 4vw, 60px) !important;
  font-weight: 300 !important;
  letter-spacing: 0.03em !important;
  line-height: 1.1 !important;
  color: #1c1917 !important;
  margin: 0 !important;
}
.ls-editorial__title em { font-style: italic; }
.ls-editorial__desc {
  font-family: 'Inter', sans-serif;
  font-size: 14px;
  line-height: 1.85;
  color: #78716c;
  max-width: 420px;
  margin: 0;
}
.ls-editorial__btns { display: flex; gap: 16px; flex-wrap: wrap; margin-top: 8px; }
.ls-editorial__btn {
  display: inline-block;
  padding: 14px 32px;
  font-family: 'Inter', sans-serif;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  text-decoration: none;
  transition: all 0.2s ease;
}
.ls-editorial__btn--primary {
  background: #1c1917;
  color: #ffffff;
}
.ls-editorial__btn--primary:hover { background: #44403c; }
.ls-editorial__btn--secondary {
  background: transparent;
  color: #1c1917;
  border: 1px solid #d6d3d1;
}
.ls-editorial__btn--secondary:hover {
  background: #1c1917;
  color: #ffffff;
  border-color: #1c1917;
}
</style>

{% schema %}
{ "name": "Lunelle Editorial", "tag": "section", "settings": [] }
{% endschema %}
